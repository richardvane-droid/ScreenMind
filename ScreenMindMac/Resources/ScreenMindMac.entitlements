<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Screen Recording (required for ScreenCaptureKit) -->
    <key>com.apple.security.screen-capture</key>
    <true/>
    <!-- HealthKit -->
    <key>com.apple.developer.healthkit</key>
    <true/>
    <key>com.apple.developer.healthkit.access</key>
    <array>
        <string>health-records</string>
    </array>
    <!-- CloudKit -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.screenmind.app</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- App Groups (shared with extensions) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.screenmind.app</string>
    </array>
    <!-- Network (for Doubao API and Ollama localhost) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- User notifications -->
    <key>com.apple.security.notification-rules</key>
    <true/>
</dict>
</plist>
