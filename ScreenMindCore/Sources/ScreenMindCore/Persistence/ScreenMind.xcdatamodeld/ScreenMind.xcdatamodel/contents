        <relationship name="triggeredSuggestion" optional="YES" maxCount="1" deletionRule="Nullify" destinationEntity="RelaxationSuggestion" inverseName="triggeredBy" inverseEntity="RelaxationSuggestion"/>
    </entity>

    <!-- ── RelaxationSuggestion ──────────────────────────────── -->
    <entity name="RelaxationSuggestion" representedClassName="RelaxationSuggestion" syncable="YES" codeGenerationType="class">
        <attribute name="id" optional="NO" attributeType="UUID" usesScalarValueType="NO"/>
        <attribute name="title" optional="NO" attributeType="String" defaultValueString=""/>
        <attribute name="detail" optional="YES" attributeType="String"/>
        <attribute name="address" optional="YES" attributeType="String"/>
        <!-- 地理地址（如填写则预计算车程） -->
        <attribute name="latitude" optional="YES" attributeType="Double" defaultValueString="0.0" usesScalarValueType="YES"/>
        <attribute name="longitude" optional="YES" attributeType="Double" defaultValueString="0.0" usesScalarValueType="YES"/>
        <attribute name="travelMinutes" optional="YES" attributeType="Integer32" defaultValueString="0" usesScalarValueType="YES"/>
        <!-- 最后一次计算的车程分钟数 -->
        <attribute name="travelUpdatedAt" optional="YES" attributeType="Date" usesScalarValueType="NO"/>
        <attribute name="isEnabled" optional="NO" attributeType="Boolean" defaultValueString="YES" usesScalarValueType="YES"/>
        <attribute name="sortOrder" optional="NO" attributeType="Integer32" defaultValueString="0" usesScalarValueType="YES"/>
        <relationship name="triggeredBy" optional="YES" toMany="YES" deletionRule="Nullify" destinationEntity="AnxietyRecord" inverseName="triggeredSuggestion" inverseEntity="AnxietyRecord"/>
    </entity>

    <!-- ── VideoAccountProfile ───────────────────────────────── -->
    <entity name="VideoAccountProfile" representedClassName="VideoAccountProfile" syncable="YES" codeGenerationType="class">
        <attribute name="id" optional="NO" attributeType="UUID" usesScalarValueType="NO"/>
